{
  "num_steps_per_env": 24,
  "save_interval": 50,
  "empirical_normalization": true,
  "logger": "tensorboard",
  "policy": {
    "class_name": "ActorCritic",
    "init_noise_std": 0.1,
    "actor_hidden_dims": [64, 64],
    "critic_hidden_dims": [64, 64],
    "activation": "elu"
  },
  "algorithm": {
    "class_name": "PPO",
    "value_loss_coef": 1.0,
    "use_clipped_value_loss": true,
    "clip_param": 0.2,
    "entropy_coef": 0.001,
    "num_learning_epochs": 4,
    "num_mini_batches": 4,
    "learning_rate": 0.0003,
    "schedule": "adaptive",
    "gamma": 0.99,
    "lam": 0.95,
    "desired_kl": 0.01,
    "max_grad_norm": 1.0
  }
}
